<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Hermes.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Hermes.App"
    xmlns:controls="using:Hermes.App.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Hermes"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <Grid.KeyboardAccelerators>
            <!--
                App-wide accelerators. Each Invoked handler routes through
                MainWindow.xaml.cs, which gates on focus + modal state so
                these don't steal keys from text boxes / dropdowns.
                Ctrl+, is wired from code-behind because VirtualKey doesn't
                expose Oem-Comma as a named value.
            -->
            <KeyboardAccelerator Key="K" Modifiers="Control" Invoked="CtrlK_Invoked" />
            <KeyboardAccelerator Key="N" Modifiers="Control" Invoked="CtrlN_Invoked" />
            <KeyboardAccelerator Key="W" Modifiers="Control" Invoked="CtrlW_Invoked" />
            <KeyboardAccelerator Key="Escape" Invoked="Escape_Invoked" />
            <!--
                Ctrl+E — TODO: bind to ChatViewModel.CopyAsMarkdownCommand
                once the parallel export sub-session lands it. Until then
                the accelerator is wired so it stops bubbling to anything
                else (Edge has Ctrl+E for search), and no-ops cleanly.
            -->
            <KeyboardAccelerator Key="E" Modifiers="Control" Invoked="CtrlE_Invoked" />
        </Grid.KeyboardAccelerators>

        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="AppTitleBar"
            Title="Hermes"
            Subtitle="Companion"
            BackRequested="TitleBar_BackRequested"
            IsBackButtonVisible="{x:Bind NavFrame.CanGoBack, Mode=OneWay}"
            IsPaneToggleButtonVisible="True"
            PaneToggleRequested="TitleBar_PaneToggleRequested">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/AppIcon.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            OpenPaneLength="220"
            PaneDisplayMode="Left"
            SelectionChanged="NavView_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Chat"
                                    IsSelected="True"
                                    Tag="chat"
                                    ToolTipService.ToolTip="Chat (Ctrl+N for new)">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8BD;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Sessions" Tag="sessions">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8FD;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItemSeparator />
                <NavigationViewItem Content="Memories" Tag="memories">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE81C;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Skills" Tag="skills">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEA86;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Jobs" Tag="jobs">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE823;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Bridges" Tag="bridges">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE968;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <Frame x:Name="NavFrame" />
        </NavigationView>

        <!--
            Command palette popup. Lives in the root Grid so its XamlRoot is
            valid (a Popup needs to be part of a XamlRoot's visual tree).
            Sits at Grid.Row=0 with no size so it doesn't take any layout
            slot when closed; the popup itself handles its own positioning
            via HorizontalOffset/VerticalOffset.
        -->
        <controls:CommandPalette x:Name="Palette"
                                 Grid.Row="0"
                                 Grid.RowSpan="2"
                                 Width="0"
                                 Height="0"
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Top" />
    </Grid>
</Window>

