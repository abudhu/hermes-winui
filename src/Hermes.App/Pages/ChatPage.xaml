<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Hermes.App.Pages.ChatPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:app="using:Hermes.App"
    xmlns:controls="using:Hermes.App.Controls"
    xmlns:vm="using:Hermes.App.ViewModels"
    mc:Ignorable="d">

    <Page.Resources>

        <!-- User bubble: right-aligned, accent-tinted, slight shadow.
             Outer Grid has two Auto rows: header (role + timestamp), then bubble. -->
        <DataTemplate x:Key="UserTemplate" x:DataType="vm:MessageVm">
            <Grid Padding="0,6,0,6" HorizontalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,0,4,4"
                            Spacing="6">
                    <TextBlock Text="{x:Bind RoleLabel}"
                               FontWeight="SemiBold"
                               FontSize="12"
                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    <TextBlock Text="{x:Bind TimeLabel}"
                               FontSize="11"
                               VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                </StackPanel>

                <Border Grid.Row="1"
                        MaxWidth="640"
                        HorizontalAlignment="Right"
                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                        CornerRadius="12,12,2,12"
                        Padding="14,10">
                    <TextBlock Text="{x:Bind Content, Mode=OneWay}"
                               Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                               TextWrapping="Wrap"
                               IsTextSelectionEnabled="True"
                               FontSize="14" />
                </Border>
            </Grid>
        </DataTemplate>

        <!-- Assistant bubble: left-aligned card with tool-call expanders.
             Outer Grid has three Auto rows: header (role + timestamp), bubble,
             then per-turn usage footer. -->
        <DataTemplate x:Key="AssistantTemplate" x:DataType="vm:MessageVm">
            <Grid Padding="0,6,0,6" HorizontalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0"
                      Margin="4,0,4,4"
                      HorizontalAlignment="Stretch"
                      ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{x:Bind RoleLabel}"
                               FontWeight="SemiBold"
                               FontSize="12"
                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    <TextBlock Grid.Column="1"
                               Text="{x:Bind TimeLabel}"
                               FontSize="11"
                               VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <Button Grid.Column="3"
                            Click="CopyResponse_Click"
                            Padding="6,2,8,2"
                            MinHeight="24"
                            FontSize="11"
                            Background="Transparent"
                            BorderThickness="0"
                            ToolTipService.ToolTip="Copy response"
                            Visibility="{x:Bind app:Converters.NotEmpty(Content), Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon FontSize="12" Glyph="&#xE8C8;" />
                            <TextBlock Text="Copy" />
                        </StackPanel>
                    </Button>
                </Grid>

                <Border Grid.Row="1"
                        MaxWidth="720"
                        HorizontalAlignment="Left"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="12,12,12,2"
                        Padding="14,10">
                    <StackPanel Spacing="8">

                        <!-- Reasoning ("thinking") trail is intentionally not shown:
                             for Hermes the "_thinking" tool.progress content is
                             usually identical to the final assistant reply, so an
                             expander here is just visual noise. Buffer + Reasoning
                             property still accumulate in MessageVm so a future
                             setting can re-expose them. -->

                        <!-- Inline tool-call cards. Collapsed when ToolCalls is
                             empty so the parent StackPanel's spacing doesn't
                             leak 8px of dead space above the Content text. -->
                        <ItemsRepeater ItemsSource="{x:Bind ToolCalls, Mode=OneWay}"
                                       Visibility="{x:Bind app:Converters.BoolToVisible(HasToolCalls), Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="6" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:ToolCallVm">
                                    <Expander HorizontalAlignment="Stretch"
                                              HorizontalContentAlignment="Stretch">
                                        <Expander.Header>
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <FontIcon Grid.Column="0"
                                                          Glyph="&#xE9F5;"
                                                          FontSize="14"
                                                          VerticalAlignment="Center"
                                                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{x:Bind Name, Mode=OneWay}"
                                                           Style="{StaticResource BodyStrongTextBlockStyle}"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2"
                                                           Text="{x:Bind Subtitle, Mode=OneWay}"
                                                           Style="{StaticResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="3"
                                                           Text="{x:Bind DurationLabel, Mode=OneWay}"
                                                           Style="{StaticResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                           Margin="0,0,8,0"
                                                           VerticalAlignment="Center"
                                                           Visibility="{x:Bind app:Converters.NotEmpty(DurationLabel), Mode=OneWay}" />
                                                <ProgressRing Grid.Column="4"
                                                              Width="14" Height="14"
                                                              IsActive="True"
                                                              Visibility="{x:Bind app:Converters.BoolToVisible(IsRunning), Mode=OneWay}" />
                                                <FontIcon Grid.Column="4"
                                                          Glyph="&#xE73E;"
                                                          FontSize="14"
                                                          VerticalAlignment="Center"
                                                          Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                                          Visibility="{x:Bind app:Converters.BoolToCollapsed(IsRunning), Mode=OneWay}" />
                                            </Grid>
                                        </Expander.Header>
                                        <StackPanel Spacing="10">
                                            <StackPanel Spacing="2"
                                                        Visibility="{x:Bind app:Converters.NotEmpty(ArgumentsJson), Mode=OneWay}">
                                                <TextBlock Text="arguments"
                                                           Style="{StaticResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Text="{x:Bind ArgumentsJson, Mode=OneWay}"
                                                           FontFamily="Consolas"
                                                           FontSize="12"
                                                           IsTextSelectionEnabled="True"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                            <StackPanel Spacing="2"
                                                        Visibility="{x:Bind app:Converters.NotEmpty(Output), Mode=OneWay}">
                                                <TextBlock Text="output"
                                                           Style="{StaticResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Text="{x:Bind Output, Mode=OneWay}"
                                                           FontFamily="Consolas"
                                                           FontSize="12"
                                                           IsTextSelectionEnabled="True"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Expander>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>

                        <controls:MarkdownPresenter Markdown="{x:Bind Content, Mode=OneWay}"
                                                    IsStreaming="{x:Bind IsStreaming, Mode=OneWay}"
                                                    Visibility="{x:Bind app:Converters.NotEmpty(Content), Mode=OneWay}" />

                        <!-- Streaming indicator only while State==Streaming -->
                        <StackPanel Orientation="Horizontal" Spacing="6"
                                    Visibility="{x:Bind app:Converters.BoolToVisible(IsStreaming), Mode=OneWay}">
                            <ProgressRing Width="12" Height="12" IsActive="True" />
                            <TextBlock Text="{x:Bind ThinkingLabel}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Per-turn token footer. Hidden until run.completed lands
                     a Usage object on the VM; for hydrated history turns
                     this shows a best-effort breakdown from token_count. -->
                <TextBlock Grid.Row="2"
                           Margin="6,4,4,0"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                           Text="{x:Bind UsageLine, Mode=OneWay}"
                           Visibility="{x:Bind app:Converters.BoolToVisible(HasUsage), Mode=OneWay}" />
            </Grid>
        </DataTemplate>

        <controls:MessageTemplateSelector x:Key="MessageSelector"
            UserTemplate="{StaticResource UserTemplate}"
            AssistantTemplate="{StaticResource AssistantTemplate}" />

        <!-- Landing-page card styles. Cards are Buttons styled to look like
             tappable surfaces: rounded corners, subtle fill, thin border,
             a faint hover lift. The hover/pressed visuals come from the
             default Button template's VisualStates — Background swaps with
             the *PointerOver / *Pressed theme resources automatically. -->
        <Style x:Key="SuggestionCardStyle" TargetType="Button">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16,18,16,18" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="MinHeight" Value="118" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        </Style>

        <!-- Same as the basic card but stretches horizontally to feel
             featured. Used for the wide right-hand card on row 1 of the
             landing grid (the "Plan my day" prompt). -->
        <Style x:Key="SuggestionFeaturedCardStyle" TargetType="Button"
               BasedOn="{StaticResource SuggestionCardStyle}">
            <Setter Property="Padding" Value="18,18,18,18" />
        </Style>

        <Style x:Key="SuggestionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="LineHeight" Value="20" />
        </Style>

        <Style x:Key="SuggestionFeaturedTitleStyle" TargetType="TextBlock"
               BasedOn="{StaticResource SuggestionTitleStyle}">
            <Setter Property="FontSize" Value="14" />
        </Style>

        <Style x:Key="SuggestionIconBubbleStyle" TargetType="Border">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>

    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header strip -->
        <Border Grid.Row="0"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                Padding="24,12">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}"
                               Text="Chat" />
                    <TextBlock x:Name="SessionLine"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="No session yet" />
                </StackPanel>
                <!-- Running session totals: hidden until the first run completes
                     (or until ResumeSessionAsync seeds from SessionDetail). -->
                <Border Grid.Column="1"
                        VerticalAlignment="Center"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="6"
                        Padding="8,3"
                        Visibility="{x:Bind app:Converters.BoolToVisible(ViewModel.HasSessionUsage), Mode=OneWay}"
                        ToolTipService.ToolTip="Total tokens used in this session">
                    <TextBlock Text="{x:Bind ViewModel.SessionUsageLine, Mode=OneWay}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Border>
                <Button Grid.Column="2"
                        Command="{x:Bind ViewModel.NewChatCommand}"
                        ToolTipService.ToolTip="Start a new chat">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                        <TextBlock Text="New chat" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Transcript -->
        <ScrollViewer x:Name="TranscriptScroll"
                      Grid.Row="1"
                      Padding="24,12,24,12"
                      VerticalScrollMode="Enabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="TranscriptContent">
                <Grid x:Name="EmptyState"
                      Padding="24,32,24,24"
                      MinHeight="420"
                      Visibility="{x:Bind app:Converters.BoolToCollapsed(ViewModel.HasMessages), Mode=OneWay}">
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="40"
                                MaxWidth="820">
                        <!-- Greeting: time-of-day + capitalized Windows username + tagline.
                             GreetingText is computed once in the code-behind ctor. -->
                        <TextBlock x:Name="GreetingText"
                                   Style="{StaticResource TitleTextBlockStyle}"
                                   FontWeight="SemiLight"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

                        <!-- Suggestion grid: 3 columns × 2 rows. Row 0 has three
                             icon-only prompts; row 1 has two prompts plus a wider
                             "featured" card spanning two columns on the right. -->
                        <Grid ColumnSpacing="14" RowSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Row 0 -->
                            <Button Grid.Row="0" Grid.Column="0"
                                    Style="{StaticResource SuggestionCardStyle}"
                                    Tag="What can you do? Give me a quick tour of your skills, tools, and how you work."
                                    Click="Suggestion_Click"
                                    AutomationProperties.Name="What can Hermes do?">
                                <StackPanel Spacing="10">
                                    <Border Style="{StaticResource SuggestionIconBubbleStyle}">
                                        <FontIcon Glyph="&#xE946;" FontSize="22"
                                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    </Border>
                                    <TextBlock Text="What can Hermes do?"
                                               Style="{StaticResource SuggestionTitleStyle}" />
                                </StackPanel>
                            </Button>

                            <Button Grid.Row="0" Grid.Column="1"
                                    Style="{StaticResource SuggestionCardStyle}"
                                    Tag="Show me my most recent memories and group them by topic."
                                    Click="Suggestion_Click"
                                    AutomationProperties.Name="Show recent memories">
                                <StackPanel Spacing="10">
                                    <Border Style="{StaticResource SuggestionIconBubbleStyle}">
                                        <FontIcon Glyph="&#xE81C;" FontSize="22"
                                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    </Border>
                                    <TextBlock Text="Show recent memories"
                                               Style="{StaticResource SuggestionTitleStyle}" />
                                </StackPanel>
                            </Button>

                            <Button Grid.Row="0" Grid.Column="2"
                                    Style="{StaticResource SuggestionCardStyle}"
                                    Tag="List my available skills and explain what each one does."
                                    Click="Suggestion_Click"
                                    AutomationProperties.Name="List my skills">
                                <StackPanel Spacing="10">
                                    <Border Style="{StaticResource SuggestionIconBubbleStyle}">
                                        <FontIcon Glyph="&#xEA86;" FontSize="22"
                                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    </Border>
                                    <TextBlock Text="List my skills"
                                               Style="{StaticResource SuggestionTitleStyle}" />
                                </StackPanel>
                            </Button>

                            <!-- Row 1 -->
                            <Button Grid.Row="1" Grid.Column="0"
                                    Style="{StaticResource SuggestionCardStyle}"
                                    Tag="Help me write a short Python script that "
                                    Click="Suggestion_Click"
                                    AutomationProperties.Name="Write a Python script">
                                <StackPanel Spacing="10">
                                    <Border Style="{StaticResource SuggestionIconBubbleStyle}">
                                        <FontIcon Glyph="&#xE943;" FontSize="22"
                                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    </Border>
                                    <TextBlock Text="Write a Python script"
                                               Style="{StaticResource SuggestionTitleStyle}" />
                                </StackPanel>
                            </Button>

                            <Button Grid.Row="1" Grid.Column="1"
                                    Style="{StaticResource SuggestionCardStyle}"
                                    Tag="Summarize what's in the current directory and highlight anything that looks interesting."
                                    Click="Suggestion_Click"
                                    AutomationProperties.Name="Summarize this folder">
                                <StackPanel Spacing="10">
                                    <Border Style="{StaticResource SuggestionIconBubbleStyle}">
                                        <FontIcon Glyph="&#xE7C3;" FontSize="22"
                                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    </Border>
                                    <TextBlock Text="Summarize this folder"
                                               Style="{StaticResource SuggestionTitleStyle}" />
                                </StackPanel>
                            </Button>

                            <!-- Featured wide card -->
                            <Button Grid.Row="1" Grid.Column="2"
                                    Style="{StaticResource SuggestionFeaturedCardStyle}"
                                    Tag="Pull my open tasks and any time-sensitive memories, then draft a plan for the rest of my day."
                                    Click="Suggestion_Click"
                                    AutomationProperties.Name="Plan my day from tasks and memories">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource SuggestionIconBubbleStyle}"
                                            VerticalAlignment="Top">
                                        <FontIcon Glyph="&#xE787;" FontSize="22"
                                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    </Border>
                                    <TextBlock Grid.Column="1"
                                               VerticalAlignment="Top"
                                               TextWrapping="Wrap"
                                               Style="{StaticResource SuggestionFeaturedTitleStyle}"
                                               Text="Plan my day from my open tasks and memories" />
                                </Grid>
                            </Button>
                        </Grid>

                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   Text="Tap a card or type a prompt below. Enter sends, Shift+Enter inserts a newline." />
                    </StackPanel>
                </Grid>

                <!-- VerticalCacheLength="100" effectively disables virtualization
                     for chat-sized transcripts. With the default (2 viewports
                     above/below), ItemsRepeater realizes/de-realizes message
                     bubbles as the user scrolls, and each realization fires
                     ScrollViewer scroll-anchoring that fights the wheel input —
                     visible as a "bounce" when scrolling over tall last messages
                     with big code blocks. For a chat transcript the working set
                     is small enough that always-realized is the right tradeoff. -->
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Messages, Mode=OneWay}"
                               ItemTemplate="{StaticResource MessageSelector}"
                               VerticalCacheLength="100"
                               HorizontalCacheLength="0">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="4" />
                    </ItemsRepeater.Layout>
                </ItemsRepeater>
            </StackPanel>
        </ScrollViewer>

        <!-- Composer: rounded "pill" with the textbox and a circular send
             button embedded inside. Floats center-aligned with a max-width
             rather than spanning the full width as a docked strip — feels
             modern (matches ChatGPT/Copilot) and pairs naturally with the
             Mica backdrop bleeding through on either side. -->
        <Grid Grid.Row="2" Padding="0,8,0,18">
            <Border x:Name="ComposerPill"
                    MaxWidth="760"
                    HorizontalAlignment="Stretch"
                    Margin="24,0,24,0"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="22"
                    Padding="18,14,10,14">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- BorderThickness=0 + Background=Transparent makes the
                         TextBox blend into the outer pill. We override the
                         TextBox's focus/hover-state brushes to Transparent so
                         clicking in doesn't paint a dark fill + accent
                         underline inside our rounded shape. Focus signal is
                         instead lifted to the outer pill border via
                         GotFocus/LostFocus in code-behind. -->
                    <TextBox x:Name="Composer"
                             Grid.Column="0"
                             PlaceholderText="Message Hermes — Enter to send, Shift+Enter for newline"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             BorderThickness="0"
                             Background="Transparent"
                             Padding="4,6,4,6"
                             MinHeight="56"
                             MaxHeight="280"
                             VerticalContentAlignment="Center"
                             VerticalAlignment="Stretch"
                             IsSpellCheckEnabled="True"
                             Text="{x:Bind ViewModel.Composer, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PreviewKeyDown="Composer_PreviewKeyDown"
                             GotFocus="Composer_GotFocus"
                             LostFocus="Composer_LostFocus">
                        <TextBox.Resources>
                            <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                        </TextBox.Resources>
                    </TextBox>

                    <!-- Send/Stop swap based on ViewModel.IsBusy. Both are
                         circular (CornerRadius=18 on a 36×36 button) and
                         dock to the bottom of the pill so a multi-line
                         composer keeps the button aligned with the last
                         line of typed text. -->
                    <Grid Grid.Column="1" VerticalAlignment="Bottom">
                        <Button x:Name="SendButton"
                                Style="{StaticResource AccentButtonStyle}"
                                Width="36" Height="36"
                                MinWidth="36" MinHeight="36"
                                Padding="0"
                                CornerRadius="18"
                                Command="{x:Bind ViewModel.SendCommand}"
                                ToolTipService.ToolTip="Send (Enter)"
                                Visibility="{x:Bind app:Converters.BoolToCollapsed(ViewModel.IsBusy), Mode=OneWay}">
                            <FontIcon Glyph="&#xE74A;" FontSize="14" />
                        </Button>
                        <Button x:Name="StopButton"
                                Width="36" Height="36"
                                MinWidth="36" MinHeight="36"
                                Padding="0"
                                CornerRadius="18"
                                Command="{x:Bind ViewModel.StopCommand}"
                                ToolTipService.ToolTip="Stop"
                                Visibility="{x:Bind app:Converters.BoolToVisible(ViewModel.IsBusy), Mode=OneWay}">
                            <FontIcon Glyph="&#xE71A;" FontSize="12" />
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
