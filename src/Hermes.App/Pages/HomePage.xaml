<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Hermes.App.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Hermes.App.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="32,24,32,32">
        <StackPanel MaxWidth="960" Spacing="20" HorizontalAlignment="Stretch">

            <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                <Ellipse x:Name="StatusDot"
                         Width="14" Height="14"
                         VerticalAlignment="Center"
                         Fill="{ThemeResource SystemFillColorNeutralBrush}" />
                <TextBlock Style="{StaticResource TitleLargeTextBlockStyle}"
                           Text="Hermes" />
                <TextBlock x:Name="StatusText"
                           Style="{StaticResource BodyStrongTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center"
                           Text="Checking…" />
                <Button Click="RefreshButton_Click"
                        VerticalAlignment="Center"
                        Margin="12,0,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                        <TextBlock Text="Refresh" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <TextBlock Style="{StaticResource BodyTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="Local Hermes gateway at a glance." />

            <!-- Status cards -->
            <Grid ColumnSpacing="16" RowSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20,16">
                    <StackPanel Spacing="4">
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="Gateway state" />
                        <TextBlock x:Name="GatewayStateText"
                                   Style="{StaticResource SubtitleTextBlockStyle}"
                                   Text="—" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20,16">
                    <StackPanel Spacing="4">
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="Active in gateway" />
                        <TextBlock x:Name="ActiveAgentsText"
                                   Style="{StaticResource SubtitleTextBlockStyle}"
                                   Text="—" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20,16">
                    <StackPanel Spacing="4">
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="Open sessions" />
                        <TextBlock x:Name="OpenSessionsText"
                                   Style="{StaticResource SubtitleTextBlockStyle}"
                                   Text="—" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="3"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20,16">
                    <StackPanel Spacing="4">
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="Model" />
                        <TextBlock x:Name="ModelText"
                                   Style="{StaticResource SubtitleTextBlockStyle}"
                                   TextTrimming="CharacterEllipsis"
                                   Text="—" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Endpoint / config info -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20,16">
                <StackPanel Spacing="8">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}"
                               Text="Configuration" />
                    <Grid ColumnSpacing="16" RowSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="Gateway URL" />
                        <TextBlock x:Name="GatewayUrlText" Grid.Row="0" Grid.Column="1"
                                   FontFamily="Consolas"
                                   IsTextSelectionEnabled="True"
                                   Text="—" />
                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="Config dir" />
                        <TextBlock x:Name="ConfigDirText" Grid.Row="1" Grid.Column="1"
                                   FontFamily="Consolas"
                                   IsTextSelectionEnabled="True"
                                   TextWrapping="Wrap"
                                   Text="—" />
                        <TextBlock Grid.Row="2" Grid.Column="0"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="API key" />
                        <TextBlock x:Name="ApiKeyText" Grid.Row="2" Grid.Column="1"
                                   FontFamily="Consolas"
                                   Text="—" />
                    </Grid>
                </StackPanel>
            </Border>

            <InfoBar x:Name="ErrorBar"
                     IsOpen="False"
                     Severity="Error"
                     Title="Could not reach gateway"
                     IsClosable="False" />
        </StackPanel>
    </ScrollViewer>
</Page>
