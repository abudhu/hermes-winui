<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Hermes.App.Pages.Settings.McpServersView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Hermes.App.ViewModels.Settings"
    x:Name="Root"
    mc:Ignorable="d">

    <Grid ColumnSpacing="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- TOP: gateway opt-in sync banner (spans both columns) -->
        <InfoBar x:Name="GatewaySyncBar"
                 Grid.Row="0"
                 Grid.Column="0"
                 Grid.ColumnSpan="2"
                 IsOpen="False"
                 IsClosable="False"
                 Severity="Warning" />

        <!-- LEFT: server list + actions -->
        <Border Grid.Row="1"
                Grid.Column="0"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="6">
            <Grid RowSpacing="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Margin="6,4,6,2"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="Configured servers" />

                <ListView x:Name="ServerList"
                          Grid.Row="1"
                          SelectionMode="Single"
                          SelectionChanged="ServerList_SelectionChanged">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:McpServerItemVm">
                            <Grid ColumnSpacing="8" Padding="2,4,2,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0" RowSpacing="4">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0"
                                               Text="{x:Bind Name, Mode=OneWay}"
                                               Style="{StaticResource BodyStrongTextBlockStyle}"
                                               TextTrimming="CharacterEllipsis" />
                                    <StackPanel Grid.Row="1"
                                                Orientation="Horizontal"
                                                Spacing="4">
                                        <Border Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                                CornerRadius="4"
                                                Padding="6,1">
                                            <TextBlock Text="{x:Bind Transport, Mode=OneWay}"
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Border>
                                        <Border Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                                CornerRadius="4"
                                                Padding="6,1"
                                                Visibility="{x:Bind IsDisabled, Mode=OneWay}">
                                            <TextBlock Text="disabled"
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                        </Border>
                                    </StackPanel>
                                </Grid>
                                <!--
                                  Per-row enabled toggle. Bound one-way to
                                  IsEnabled (computed from the body's
                                  'enabled' key). Flips are handled in
                                  code-behind via the Toggled event, which
                                  saves immediately through the same
                                  HermesYamlConfig.Save path the rest of
                                  the editor uses. IsEnabled-on-the-control
                                  is bound to the parent UserControl's
                                  AreRowTogglesEnabled DependencyProperty
                                  so editor-dirty state disables every row
                                  toggle at once with a tooltip.
                                  Tapped/PointerPressed handlers block the
                                  click from also selecting the row.
                                -->
                                <ToggleSwitch Grid.Column="1"
                                              VerticalAlignment="Center"
                                              MinWidth="0"
                                              OnContent=""
                                              OffContent=""
                                              IsOn="{x:Bind IsEnabled, Mode=OneWay}"
                                              IsEnabled="{Binding ElementName=Root, Path=AreRowTogglesEnabled, Mode=OneWay}"
                                              ToolTipService.ToolTip="{Binding ElementName=Root, Path=RowTogglesTooltip, Mode=OneWay}"
                                              Toggled="RowEnabled_Toggled"
                                              Tapped="RowToggle_Tapped"
                                              PointerPressed="RowToggle_PointerPressed" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock x:Name="EmptyHint"
                           Grid.Row="1"
                           Margin="8,12"
                           VerticalAlignment="Top"
                           HorizontalAlignment="Stretch"
                           TextWrapping="Wrap"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                           Visibility="Collapsed"
                           Text="No MCP servers configured. Click 'Add server' to pick a template or start from scratch." />

                <!--
                  "Add server" splits into Empty + Templates. Templates
                  pre-fill the form with a working JSON skeleton for the
                  popular MCP servers — users still tweak paths / API
                  tokens but don't have to memorise the schema.
                -->
                <DropDownButton x:Name="AddServerButton"
                                Grid.Row="2"
                                Margin="2,4,2,2"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch">
                    <DropDownButton.Content>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0"
                                        Orientation="Horizontal"
                                        Spacing="6"
                                        HorizontalAlignment="Left">
                                <FontIcon Glyph="&#xE710;" FontSize="14" />
                                <TextBlock Text="Add server" />
                            </StackPanel>
                        </Grid>
                    </DropDownButton.Content>
                    <DropDownButton.Flyout>
                        <MenuFlyout x:Name="AddServerFlyout" Placement="Bottom">
                            <MenuFlyoutItem Text="Empty server" Click="AddEmpty_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE7C3;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="filesystem"
                                            Tag="filesystem"
                                            Click="AddTemplate_Click" />
                            <MenuFlyoutItem Text="git"
                                            Tag="git"
                                            Click="AddTemplate_Click" />
                            <MenuFlyoutItem Text="github"
                                            Tag="github"
                                            Click="AddTemplate_Click" />
                            <MenuFlyoutItem Text="memory"
                                            Tag="memory"
                                            Click="AddTemplate_Click" />
                            <MenuFlyoutItem Text="fetch"
                                            Tag="fetch"
                                            Click="AddTemplate_Click" />
                            <MenuFlyoutItem Text="time"
                                            Tag="time"
                                            Click="AddTemplate_Click" />
                            <MenuFlyoutItem Text="sequential-thinking"
                                            Tag="sequential-thinking"
                                            Click="AddTemplate_Click" />
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
            </Grid>
        </Border>

        <!-- RIGHT: editor -->
        <Border Grid.Row="1"
                Grid.Column="1"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="20,16">
            <Grid RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Grid.Column="0"
                              Glyph="&#xE713;"
                              FontSize="14"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                              VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               x:Name="EditorTitle"
                               Style="{StaticResource BodyStrongTextBlockStyle}"
                               VerticalAlignment="Center"
                               Text="Edit server" />
                </Grid>

                <!-- Status InfoBar (errors / warnings / success) -->
                <InfoBar x:Name="EditorStatusBar"
                         Grid.Row="1"
                         IsOpen="False"
                         IsClosable="True"
                         Severity="Informational" />

                <!-- "Restart gateway" hint after a save -->
                <InfoBar x:Name="ReloadHintBar"
                         Grid.Row="2"
                         IsOpen="False"
                         IsClosable="True"
                         Severity="Warning"
                         Title="Restart the Hermes gateway to apply"
                         Message="The Hermes gateway only discovers MCP servers at startup. Stop and restart hermes.exe (and its gateway process) for the WinUI chat to see your edits. New chat sessions started after restart will pick up the new tools.">
                    <InfoBar.ActionButton>
                        <Button Content="Show restart steps"
                                Click="RestartHermes_Click" />
                    </InfoBar.ActionButton>
                </InfoBar>

                <!-- Name -->
                <Grid Grid.Row="3" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               VerticalAlignment="Center"
                               Text="Name"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBox x:Name="NameBox"
                             Grid.Column="1"
                             FontFamily="Consolas"
                             PlaceholderText="filesystem"
                             TextChanged="Editor_Changed" />
                </Grid>

                <!--
                  Editor-pane Enabled toggle. Source of truth is the JSON
                  body (BodyBox) — flipping the toggle mutates the parsed
                  body and re-serializes it into BodyBox; typing into
                  BodyBox re-parses and reflects the resulting enabled
                  state back into the toggle. When BodyBox isn't valid
                  JSON the toggle is disabled with a hint caption so it
                  never displays a stale or misleading state.
                -->
                <Grid Grid.Row="4" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               VerticalAlignment="Center"
                               Text="Enabled"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="12"
                                VerticalAlignment="Center">
                        <!--
                          IMPORTANT: Do NOT set IsOn= in XAML on this toggle.
                          The combination of OnContent/OffContent text and a
                          literal IsOn=True attribute crashes Windows App SDK
                          2.1.3's XAML parser at McpServersView instantiation
                          time with "Failed to assign to property
                          ToggleSwitch.IsOn"; the failure surfaces as a
                          stowed exception inside SettingsPage.InitializeComponent
                          and looks like a render-time crash. Initial IsOn is set
                          from code-behind in SyncEditorToggleFromBody() the
                          moment a server is selected (or a new-server form is
                          shown), so leaving it unset here has no visible effect.
                        -->
                        <ToggleSwitch x:Name="EditorEnabledToggle"
                                      MinWidth="0"
                                      OnContent="On"
                                      OffContent="Off"
                                      Toggled="EditorEnabled_Toggled" />
                        <TextBlock x:Name="EditorEnabledHint"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   TextWrapping="Wrap"
                                   Text="" />
                    </StackPanel>
                </Grid>

                <!--
                  Form-compat banner. Shows only when the body has
                  managed keys with wrong types (args containing numbers,
                  env values that aren't strings, etc.) — surfaces this
                  before the user notices the form is empty/stale.
                -->
                <InfoBar x:Name="FormCompatBar"
                         Grid.Row="5"
                         IsOpen="False"
                         IsClosable="False"
                         Severity="Warning"
                         Title="Use Raw JSON to edit this server"
                         Message="This server uses fields the structured form can't safely edit. Scroll down to Raw JSON." />

                <!-- Main editor body: structured form + raw JSON expander -->
                <ScrollViewer Grid.Row="6"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="FormPanel" Spacing="12">

                        <!-- Transport -->
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       VerticalAlignment="Center"
                                       Text="Transport"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <RadioButtons Grid.Column="1"
                                          x:Name="TransportRadios"
                                          MaxColumns="2"
                                          SelectionChanged="Transport_Changed">
                                <RadioButton x:Name="TransportStdio" Content="stdio (command)" />
                                <RadioButton x:Name="TransportHttp" Content="HTTP / SSE (URL)" />
                            </RadioButtons>
                        </Grid>

                        <!-- stdio: Command -->
                        <Grid x:Name="CommandRow" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       VerticalAlignment="Center"
                                       Text="Command"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBox x:Name="CommandBox"
                                     Grid.Column="1"
                                     FontFamily="Consolas"
                                     PlaceholderText="uvx, npx, python, ..."
                                     TextChanged="FormField_Changed" />
                        </Grid>

                        <!-- stdio: Args -->
                        <StackPanel x:Name="ArgsSection" Spacing="6">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           VerticalAlignment="Center"
                                           Text="Args"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <Button Grid.Column="2" Click="AddArg_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon Glyph="&#xE710;" FontSize="12" />
                                        <TextBlock Text="Add arg" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <ItemsRepeater x:Name="ArgsRepeater">
                                <ItemsRepeater.Layout>
                                    <StackLayout Spacing="4" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="vm:EditableStringVm">
                                        <Grid ColumnSpacing="6" Margin="132,0,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0"
                                                     FontFamily="Consolas"
                                                     Text="{x:Bind Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     TextChanged="ArgItem_Changed" />
                                            <Button Grid.Column="1"
                                                    Click="RemoveArg_Click"
                                                    ToolTipService.ToolTip="Remove this arg">
                                                <FontIcon Glyph="&#xE74D;" FontSize="12" />
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>

                        <!-- stdio: Env vars -->
                        <StackPanel x:Name="EnvSection" Spacing="6">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           VerticalAlignment="Center"
                                           Text="Env vars"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <Button Grid.Column="2" Click="AddEnv_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon Glyph="&#xE710;" FontSize="12" />
                                        <TextBlock Text="Add env var" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <ItemsRepeater x:Name="EnvRepeater">
                                <ItemsRepeater.Layout>
                                    <StackLayout Spacing="4" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="vm:EditableKeyValueVm">
                                        <Grid ColumnSpacing="6" Margin="132,0,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="180" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0"
                                                     FontFamily="Consolas"
                                                     PlaceholderText="KEY"
                                                     Text="{x:Bind Key, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     TextChanged="EnvItem_Changed" />
                                            <TextBox Grid.Column="1"
                                                     FontFamily="Consolas"
                                                     PlaceholderText="value"
                                                     Text="{x:Bind Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     TextChanged="EnvItem_Changed" />
                                            <Button Grid.Column="2"
                                                    Click="RemoveEnv_Click"
                                                    ToolTipService.ToolTip="Remove this env var">
                                                <FontIcon Glyph="&#xE74D;" FontSize="12" />
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>

                        <!-- HTTP: URL -->
                        <Grid x:Name="UrlRow" ColumnSpacing="12" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       VerticalAlignment="Center"
                                       Text="URL"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBox x:Name="UrlBox"
                                     Grid.Column="1"
                                     FontFamily="Consolas"
                                     PlaceholderText="https://example.com/mcp"
                                     TextChanged="FormField_Changed" />
                        </Grid>

                        <!-- HTTP: Headers -->
                        <StackPanel x:Name="HeadersSection" Spacing="6" Visibility="Collapsed">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           VerticalAlignment="Center"
                                           Text="Headers"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <Button Grid.Column="2" Click="AddHeader_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon Glyph="&#xE710;" FontSize="12" />
                                        <TextBlock Text="Add header" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <ItemsRepeater x:Name="HeadersRepeater">
                                <ItemsRepeater.Layout>
                                    <StackLayout Spacing="4" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="vm:EditableKeyValueVm">
                                        <Grid ColumnSpacing="6" Margin="132,0,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="180" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0"
                                                     FontFamily="Consolas"
                                                     PlaceholderText="Header-Name"
                                                     Text="{x:Bind Key, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     TextChanged="HeaderItem_Changed" />
                                            <TextBox Grid.Column="1"
                                                     FontFamily="Consolas"
                                                     PlaceholderText="value"
                                                     Text="{x:Bind Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     TextChanged="HeaderItem_Changed" />
                                            <Button Grid.Column="2"
                                                    Click="RemoveHeader_Click"
                                                    ToolTipService.ToolTip="Remove this header">
                                                <FontIcon Glyph="&#xE74D;" FontSize="12" />
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>

                        <!-- Optional: Timeout (both transports) -->
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       VerticalAlignment="Center"
                                       Text="Timeout (s)"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <NumberBox x:Name="TimeoutBox"
                                       Grid.Column="1"
                                       HorizontalAlignment="Left"
                                       Width="160"
                                       Minimum="1"
                                       Maximum="86400"
                                       SpinButtonPlacementMode="Hidden"
                                       PlaceholderText="(default)"
                                       ValueChanged="FormField_Changed" />
                        </Grid>

                        <!--
                          Raw JSON Expander. Contains the BodyBox — the
                          canonical source-of-truth that the save/dirty
                          machinery still reads from. Form edits push
                          here; raw edits flow back into the form.
                        -->
                        <Expander HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Stretch">
                            <Expander.Header>
                                <TextBlock Text="Raw JSON"
                                           Style="{StaticResource BodyStrongTextBlockStyle}" />
                            </Expander.Header>
                            <StackPanel Spacing="8">
                                <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                           TextWrapping="Wrap"
                                           Text="Values you enter here may include API tokens — they are written verbatim to your config.yaml. Editing here updates the form above (and vice versa) so long as the JSON is valid and uses known field shapes." />
                                <Border BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        MinHeight="200"
                                        MaxHeight="380">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Auto">
                                        <TextBox x:Name="BodyBox"
                                                 AcceptsReturn="True"
                                                 TextWrapping="NoWrap"
                                                 FontFamily="Consolas"
                                                 BorderThickness="0"
                                                 MinHeight="200"
                                                 TextChanged="Body_Changed" />
                                    </ScrollViewer>
                                </Border>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>

                <!-- Status caption -->
                <TextBlock Grid.Row="7"
                           x:Name="DirtyHint"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                           Text="" />

                <!-- Action row -->
                <Grid Grid.Row="8" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="RemoveButton"
                            Grid.Column="0"
                            Click="Remove_Click"
                            IsEnabled="False">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE74D;" FontSize="14" />
                            <TextBlock Text="Remove" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="RestartHermesButton"
                            Grid.Column="2"
                            Click="RestartHermes_Click"
                            ToolTipService.ToolTip="Show the command to restart the Hermes gateway so it picks up your MCP changes.">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                            <TextBlock Text="Restart Hermes" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="RevertButton"
                            Grid.Column="3"
                            Click="Revert_Click"
                            IsEnabled="False"
                            Content="Revert" />
                    <Button x:Name="SaveButton"
                            Grid.Column="4"
                            Click="Save_Click"
                            IsEnabled="False"
                            Style="{StaticResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE74E;" FontSize="14" />
                            <TextBlock Text="Save server" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
