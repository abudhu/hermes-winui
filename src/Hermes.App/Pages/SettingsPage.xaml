<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Hermes.App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:app="using:Hermes.App"
    xmlns:vm="using:Hermes.App.ViewModels"
    mc:Ignorable="d">

    <ScrollViewer Padding="32,24,32,32" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="880" Spacing="24" HorizontalAlignment="Stretch">

            <TextBlock Style="{StaticResource TitleLargeTextBlockStyle}" Text="Settings" />

            <!-- Gateway -->
            <StackPanel Spacing="10">
                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Gateway" />
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20,16">
                    <StackPanel Spacing="14">

                        <!-- Host + Port -->
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="100" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0"
                                       VerticalAlignment="Center"
                                       Text="Host"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Row="0" Grid.Column="2"
                                       VerticalAlignment="Center"
                                       Text="Port"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBox x:Name="HostBox"
                                     Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                     FontFamily="Consolas"
                                     PlaceholderText="127.0.0.1"
                                     TextChanged="Field_Changed" />
                            <NumberBox x:Name="PortBox"
                                       Grid.Row="1" Grid.Column="2"
                                       Margin="0"
                                       Minimum="1"
                                       Maximum="65535"
                                       SpinButtonPlacementMode="Hidden"
                                       ValueChanged="Field_Changed" />
                        </Grid>

                        <!-- Model -->
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       VerticalAlignment="Center"
                                       Text="Model"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBox x:Name="ModelBox"
                                     Grid.Column="1"
                                     FontFamily="Consolas"
                                     PlaceholderText="hermes-agent"
                                     TextChanged="Field_Changed" />
                        </Grid>

                        <!-- API key (masked, with reveal + rotate + copy) -->
                        <Grid ColumnSpacing="8" RowSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0"
                                       VerticalAlignment="Center"
                                       Text="API key"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <PasswordBox x:Name="ApiKeyBox"
                                         Grid.Row="0" Grid.Column="1"
                                         FontFamily="Consolas"
                                         PasswordRevealMode="Peek"
                                         PasswordChanged="ApiKeyBox_PasswordChanged" />
                            <Button Grid.Row="0" Grid.Column="2"
                                    Click="GenerateKey_Click"
                                    ToolTipService.ToolTip="Generate a cryptographically random key">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                    <TextBlock Text="Generate" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Row="0" Grid.Column="3"
                                    Click="CopyKey_Click"
                                    ToolTipService.ToolTip="Copy the current key to clipboard">
                                <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                            </Button>
                            <TextBlock x:Name="ApiKeyHint"
                                       Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       Text="—" />
                        </Grid>

                        <!-- Config directory (still read-only; we don't move .env) -->
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Config directory"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="ConfigDirText" Grid.Column="1"
                                       FontFamily="Consolas"
                                       IsTextSelectionEnabled="True"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"
                                       Text="—" />
                            <Button Grid.Column="2"
                                    Click="OpenConfig_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE838;" FontSize="14" />
                                    <TextBlock Text="Open" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Save/Revert + status InfoBar -->
                        <InfoBar x:Name="SaveStatusBar"
                                 IsOpen="False"
                                 IsClosable="True"
                                 Severity="Informational" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="DirtyHint"
                                       Grid.Column="0"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       Text="" />
                            <Button x:Name="RevertButton"
                                    Grid.Column="1"
                                    Click="Revert_Click"
                                    IsEnabled="False"
                                    Content="Revert" />
                            <Button x:Name="SaveButton"
                                    Grid.Column="2"
                                    Click="Save_Click"
                                    IsEnabled="False"
                                    Style="{StaticResource AccentButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE74E;" FontSize="14" />
                                    <TextBlock Text="Save" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Capabilities feature matrix -->
            <StackPanel Spacing="10">
                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Capabilities" />
                <TextBlock x:Name="CapsStatus"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="Loading…" />
                <ItemsRepeater ItemsSource="{x:Bind Features, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout MinColumnSpacing="8"
                                           MinRowSpacing="8"
                                           MinItemWidth="260"
                                           MinItemHeight="44" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:FeatureFlagVm">
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="12,8">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0"
                                              Glyph="{x:Bind Glyph}"
                                              FontSize="14"
                                              Foreground="{x:Bind Foreground}"
                                              VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1"
                                               Text="{x:Bind Name}"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </StackPanel>

            <!-- About -->
            <StackPanel Spacing="10">
                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="About" />
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20,16">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Hermes WinUI companion"
                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="A Windows-native dashboard, chat, and session explorer for the local Hermes agent."
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="VersionText"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   FontFamily="Consolas" />
                    </StackPanel>
                </Border>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
