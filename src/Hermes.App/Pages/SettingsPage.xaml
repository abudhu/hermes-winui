<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Hermes.App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:app="using:Hermes.App"
    xmlns:vm="using:Hermes.App.ViewModels"
    mc:Ignorable="d">

    <ScrollViewer Padding="32,24,32,32" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="880" Spacing="24" HorizontalAlignment="Stretch">

            <TextBlock Style="{StaticResource TitleLargeTextBlockStyle}" Text="Settings" />

            <!-- Gateway -->
            <StackPanel Spacing="10">
                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Gateway" />
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20,16">
                    <StackPanel Spacing="14">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Base URL"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="BaseUrlText" Grid.Column="1"
                                       FontFamily="Consolas"
                                       IsTextSelectionEnabled="True"
                                       Text="—" />
                        </Grid>
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Model"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="ModelText" Grid.Column="1"
                                       FontFamily="Consolas"
                                       IsTextSelectionEnabled="True"
                                       Text="—" />
                        </Grid>
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="API key"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="ApiKeyText" Grid.Column="1"
                                       FontFamily="Consolas"
                                       Text="—" />
                        </Grid>
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Config directory"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="ConfigDirText" Grid.Column="1"
                                       FontFamily="Consolas"
                                       IsTextSelectionEnabled="True"
                                       TextWrapping="Wrap"
                                       Text="—" />
                            <Button Grid.Column="2"
                                    Click="OpenConfig_Click"
                                    Margin="8,0,0,0">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE838;" FontSize="14" />
                                    <TextBlock Text="Open" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Capabilities feature matrix -->
            <StackPanel Spacing="10">
                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Capabilities" />
                <TextBlock x:Name="CapsStatus"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="Loading…" />
                <ItemsRepeater ItemsSource="{x:Bind Features, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout MinColumnSpacing="8"
                                           MinRowSpacing="8"
                                           MinItemWidth="260"
                                           MinItemHeight="44" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:FeatureFlagVm">
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="12,8">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0"
                                              Glyph="{x:Bind Glyph}"
                                              FontSize="14"
                                              Foreground="{x:Bind Foreground}"
                                              VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1"
                                               Text="{x:Bind Name}"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </StackPanel>

            <!-- About -->
            <StackPanel Spacing="10">
                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="About" />
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20,16">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Hermes WinUI companion"
                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="A Windows-native dashboard, chat, and session explorer for the local Hermes agent."
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="VersionText"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   FontFamily="Consolas" />
                    </StackPanel>
                </Border>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
