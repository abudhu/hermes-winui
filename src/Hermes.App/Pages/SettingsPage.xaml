<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Hermes.App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:app="using:Hermes.App"
    xmlns:vm="using:Hermes.App.ViewModels"
    xmlns:settings="using:Hermes.App.Pages.Settings"
    mc:Ignorable="d">

    <!--
      Settings shell. Left-side nav rail (~200px) switches between three
      content panes. Drives Visibility on the panes from NavRail_SelectionChanged
      so we don't pay the cost of three sub-pages just for a settings split.
      Section names exposed in the rail are the user-visible labels — code
      keeps the historical names (GatewayPane, McpPane, etc.) so the
      navigation-guard contract (SettingsPage.HasUnsavedChanges) and the
      Save/Revert flow don't have to move.
    -->
    <Grid Padding="32,24,32,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left nav rail -->
        <ListView x:Name="NavRail"
                  Grid.Column="0"
                  SelectionMode="Single"
                  SelectionChanged="NavRail_SelectionChanged"
                  Background="Transparent"
                  Margin="0,0,16,0">
            <ListViewItem x:Name="ConnectionNavItem" IsSelected="True">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Grid.Column="0" Glyph="&#xE839;" FontSize="16" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="Connection" VerticalAlignment="Center" />
                </Grid>
            </ListViewItem>
            <ListViewItem x:Name="McpNavItem">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Grid.Column="0" Glyph="&#xE74C;" FontSize="16" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="MCP servers" VerticalAlignment="Center" />
                </Grid>
            </ListViewItem>
            <ListViewItem x:Name="DiagnosticsNavItem">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Grid.Column="0" Glyph="&#xE9D9;" FontSize="16" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="Diagnostics" VerticalAlignment="Center" />
                </Grid>
            </ListViewItem>
            <ListViewItem x:Name="AboutNavItem">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Grid.Column="0" Glyph="&#xE946;" FontSize="16" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="About" VerticalAlignment="Center" />
                </Grid>
            </ListViewItem>
        </ListView>

        <!-- Content area: panes overlay each other and toggle Visibility. -->
        <Grid Grid.Column="1">

            <!-- Connection pane (formerly "Gateway") -->
            <ScrollViewer x:Name="ConnectionPane"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="GatewayPane"
                            MaxWidth="780"
                            HorizontalAlignment="Stretch"
                            Spacing="20">

                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Connection" />

                    <!--
                      Live connection status. Probes /health/detailed against
                      the persisted config (the singleton HermesApiClient
                      bound at app startup). After Save, the indicator keeps
                      showing the old config's status because the running
                      HttpClients still hold the old BaseAddress / bearer —
                      the post-save InfoBar already tells the user to restart.
                    -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16,12">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Ellipse x:Name="StatusDot"
                                     Grid.Column="0"
                                     Width="10"
                                     Height="10"
                                     VerticalAlignment="Center"
                                     Fill="{ThemeResource TextFillColorDisabledBrush}" />
                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                <TextBlock x:Name="StatusText"
                                           Style="{StaticResource BodyStrongTextBlockStyle}"
                                           Text="Probing gateway…" />
                                <TextBlock x:Name="StatusDetail"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap"
                                           Visibility="Collapsed"
                                           Text="" />
                            </StackPanel>
                            <Button x:Name="StatusRefreshButton"
                                    Grid.Column="2"
                                    Click="ProbeStatus_Click"
                                    ToolTipService.ToolTip="Refresh status">
                                <FontIcon Glyph="&#xE72C;" FontSize="14" />
                            </Button>
                        </Grid>
                    </Border>

                <!-- Gateway -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20,16">
                    <StackPanel Spacing="14">

                        <!-- Host + Port -->
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="100" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0"
                                       VerticalAlignment="Center"
                                       Text="Host"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Row="0" Grid.Column="2"
                                       VerticalAlignment="Center"
                                       Text="Port"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBox x:Name="HostBox"
                                     Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                     FontFamily="Consolas"
                                     PlaceholderText="127.0.0.1"
                                     TextChanged="Field_Changed" />
                            <NumberBox x:Name="PortBox"
                                       Grid.Row="1" Grid.Column="2"
                                       Margin="0"
                                       Minimum="1"
                                       Maximum="65535"
                                       SpinButtonPlacementMode="Hidden"
                                       ValueChanged="Field_Changed" />
                        </Grid>

                        <!-- Model -->
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       VerticalAlignment="Center"
                                       Text="Model"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBox x:Name="ModelBox"
                                     Grid.Column="1"
                                     FontFamily="Consolas"
                                     PlaceholderText="hermes-agent"
                                     TextChanged="Field_Changed" />
                        </Grid>

                        <!-- API key (masked, with reveal + rotate + copy) -->
                        <Grid ColumnSpacing="8" RowSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0"
                                       VerticalAlignment="Center"
                                       Text="API key"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <PasswordBox x:Name="ApiKeyBox"
                                         Grid.Row="0" Grid.Column="1"
                                         FontFamily="Consolas"
                                         PasswordRevealMode="Peek"
                                         PasswordChanged="ApiKeyBox_PasswordChanged" />
                            <Button Grid.Row="0" Grid.Column="2"
                                    Click="GenerateKey_Click"
                                    ToolTipService.ToolTip="Generate a cryptographically random key">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                    <TextBlock Text="Generate" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Row="0" Grid.Column="3"
                                    Click="CopyKey_Click"
                                    ToolTipService.ToolTip="Copy the current key to clipboard">
                                <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                            </Button>
                            <TextBlock x:Name="ApiKeyHint"
                                       Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       Text="—" />
                        </Grid>

                        <!-- Save/Revert/Test + status InfoBar -->
                        <InfoBar x:Name="SaveStatusBar"
                                 IsOpen="False"
                                 IsClosable="True"
                                 Severity="Informational" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="DirtyHint"
                                       Grid.Column="0"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       Text="" />
                            <!--
                              Test connection uses the CURRENT form values
                              (not the persisted ones), so you can validate
                              changes before saving. Always enabled — even
                              when the form isn't dirty, "did my saved
                              config actually work?" is a valid question.
                            -->
                            <Button x:Name="TestButton"
                                    Grid.Column="1"
                                    Click="Test_Click"
                                    ToolTipService.ToolTip="Ping the gateway using the values in the form (without saving)">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE9D9;" FontSize="14" />
                                    <TextBlock Text="Test connection" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="RevertButton"
                                    Grid.Column="2"
                                    Click="Revert_Click"
                                    IsEnabled="False"
                                    Content="Revert" />
                            <Button x:Name="SaveButton"
                                    Grid.Column="3"
                                    Click="Save_Click"
                                    IsEnabled="False"
                                    Style="{StaticResource AccentButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE74E;" FontSize="14" />
                                    <TextBlock Text="Save" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <!--
                  Config directory tucked into a collapsed Expander —
                  reference info, not something users adjust. The
                  ConfigDirText element keeps its name so code-behind
                  doesn't have to change.
                -->
                <Expander HorizontalAlignment="Stretch">
                    <Expander.Header>
                        <TextBlock Text="Where files live"
                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                    </Expander.Header>
                    <Grid ColumnSpacing="16" Padding="0,4,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="Config directory"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="ConfigDirText"
                                       FontFamily="Consolas"
                                       IsTextSelectionEnabled="True"
                                       TextWrapping="Wrap"
                                       Text="—" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Click="OpenConfig_Click"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE838;" FontSize="14" />
                                <TextBlock Text="Open" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Expander>

                <!-- Capabilities matrix moved to the Diagnostics pane. -->
                </StackPanel>
            </ScrollViewer>

            <!-- MCP pane host. Don't wrap McpServersView in a ScrollViewer —
                 the control owns its own *-row sizing and internal scrolling. -->
            <Grid x:Name="McpPaneHost" Visibility="Collapsed" RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0"
                           Style="{StaticResource SubtitleTextBlockStyle}"
                           Text="MCP servers" />
                <settings:McpServersView x:Name="McpPane" Grid.Row="1" />
            </Grid>

            <!-- Diagnostics pane -->
            <ScrollViewer x:Name="DiagnosticsPane"
                          Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel MaxWidth="820"
                            HorizontalAlignment="Stretch"
                            Spacing="16">

                    <!-- Header row: title + Refresh + Copy debug info -->
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Style="{StaticResource SubtitleTextBlockStyle}"
                                   Text="Diagnostics"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1"
                                x:Name="DiagnosticsRefreshButton"
                                Click="RefreshDiagnostics_Click"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                <TextBlock Text="Refresh" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2"
                                Click="CopyDebugInfo_Click"
                                Style="{StaticResource AccentButtonStyle}"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                                <TextBlock Text="Copy debug info" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Status InfoBar (refresh / copy / open errors land here) -->
                    <InfoBar x:Name="DiagnosticsStatusBar"
                             IsOpen="False"
                             IsClosable="True"
                             Severity="Informational" />

                    <!-- Gateway card -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="20,16">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Gateway"
                                       Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <Grid ColumnSpacing="16" RowSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0"
                                           Text="State"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Row="0" Grid.Column="1"
                                           x:Name="GatewayStateText"
                                           IsTextSelectionEnabled="True"
                                           Text="—" />

                                <TextBlock Grid.Row="1" Grid.Column="0"
                                           Text="PID"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Row="1" Grid.Column="1"
                                           x:Name="GatewayPidText"
                                           FontFamily="Consolas"
                                           IsTextSelectionEnabled="True"
                                           Text="—" />

                                <TextBlock Grid.Row="2" Grid.Column="0"
                                           Text="Kind"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Row="2" Grid.Column="1"
                                           x:Name="GatewayKindText"
                                           FontFamily="Consolas"
                                           IsTextSelectionEnabled="True"
                                           Text="—" />

                                <TextBlock Grid.Row="3" Grid.Column="0"
                                           Text="Uptime"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Row="3" Grid.Column="1"
                                           x:Name="GatewayUptimeText"
                                           IsTextSelectionEnabled="True"
                                           Text="—" />

                                <TextBlock Grid.Row="4" Grid.Column="0"
                                           Text="Active agents"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Row="4" Grid.Column="1"
                                           x:Name="GatewayActiveAgentsText"
                                           IsTextSelectionEnabled="True"
                                           Text="—" />

                                <TextBlock Grid.Row="5" Grid.Column="0"
                                           Text="Last updated"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Row="5" Grid.Column="1"
                                           x:Name="GatewayUpdatedText"
                                           IsTextSelectionEnabled="True"
                                           Text="—" />

                                <TextBlock Grid.Row="6" Grid.Column="0"
                                           Text="Exit reason"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           x:Name="GatewayExitReasonLabel"
                                           Visibility="Collapsed" />
                                <TextBlock Grid.Row="6" Grid.Column="1"
                                           x:Name="GatewayExitReasonText"
                                           IsTextSelectionEnabled="True"
                                           TextWrapping="Wrap"
                                           Text=""
                                           Visibility="Collapsed" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Platform bridges card (populated only when /health/detailed returns platforms) -->
                    <Border x:Name="PlatformBridgesCard"
                            Visibility="Collapsed"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="20,16">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Platform bridges"
                                       Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <ItemsRepeater x:Name="PlatformBridges">
                                <ItemsRepeater.Layout>
                                    <StackLayout Spacing="6" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="vm:PlatformBridgeVm">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="20" />
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Grid.Column="0"
                                                      Glyph="{x:Bind Glyph}"
                                                      FontSize="14"
                                                      Foreground="{x:Bind Foreground}"
                                                      VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{x:Bind Name}"
                                                       FontFamily="Consolas"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2"
                                                       Text="{x:Bind StateDescription}"
                                                       TextWrapping="Wrap"
                                                       VerticalAlignment="Center"
                                                       Style="{StaticResource CaptionTextBlockStyle}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>
                    </Border>

                    <!-- Capabilities card (moved from Connection) -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="20,16">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Capabilities"
                                       Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock x:Name="CapsStatus"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="Loading…" />
                            <ItemsRepeater ItemsSource="{x:Bind Features, Mode=OneWay}">
                                <ItemsRepeater.Layout>
                                    <UniformGridLayout MinColumnSpacing="8"
                                                       MinRowSpacing="8"
                                                       MinItemWidth="260"
                                                       MinItemHeight="44" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="vm:FeatureFlagVm">
                                        <Border Background="{ThemeResource ControlFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="12,8">
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <FontIcon Grid.Column="0"
                                                          Glyph="{x:Bind Glyph}"
                                                          FontSize="14"
                                                          Foreground="{x:Bind Foreground}"
                                                          VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{x:Bind Name}"
                                                           Style="{StaticResource CaptionTextBlockStyle}"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>
                    </Border>

                    <!-- Logs card -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="20,16">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="Logs"
                                           Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock x:Name="LogDirText"
                                           FontFamily="Consolas"
                                           IsTextSelectionEnabled="True"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap"
                                           Text="—" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Click="OpenLogs_Click"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE838;" FontSize="14" />
                                    <TextBlock Text="Open" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- About pane -->
            <ScrollViewer x:Name="AboutPane"
                          Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel MaxWidth="780"
                            HorizontalAlignment="Stretch"
                            Spacing="16">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="About" />
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="20,16">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Hermes WinUI companion"
                                       Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="A Windows-native dashboard, chat, and session explorer for the local Hermes agent."
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" />
                            <TextBlock x:Name="VersionText"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       FontFamily="Consolas" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

        </Grid>
    </Grid>
</Page>
