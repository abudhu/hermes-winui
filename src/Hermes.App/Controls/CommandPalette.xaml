<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Hermes.App.Controls.CommandPalette"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives"
    xmlns:services="using:Hermes.App.Services"
    xmlns:local="using:Hermes.App"
    mc:Ignorable="d">

    <!--
        A Popup with IsLightDismissEnabled gives us free Esc + click-outside
        dismissal without the "one ContentDialog per XamlRoot" headache. The
        Popup is positioned absolutely via its HorizontalOffset/VerticalOffset
        in code-behind so it stays centered as the window is resized.
    -->
    <primitives:Popup x:Name="PaletteRoot"
                      IsLightDismissEnabled="True"
                      ShouldConstrainToRootBounds="True"
                      Closed="PaletteRoot_Closed">
        <!-- Hard-coded outer width so the palette stays a consistent shape
             across window sizes. The 560/480 split feels right on 1100w
             default window and still fits a 900w window without clipping. -->
        <Border x:Name="PaletteShell"
                Width="560"
                Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="12">
            <Border.Shadow>
                <ThemeShadow />
            </Border.Shadow>
            <Grid Translation="0,0,32">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0"
                      Padding="12,10,12,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Grid.Column="0"
                              Glyph="&#xE721;"
                              FontSize="16"
                              Margin="4,0,8,0"
                              VerticalAlignment="Center"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBox x:Name="SearchBox"
                             Grid.Column="1"
                             PlaceholderText="Search commands, sessions, jobs…"
                             BorderThickness="0"
                             Background="Transparent"
                             FontSize="14"
                             TextChanged="SearchBox_TextChanged"
                             PreviewKeyDown="SearchBox_PreviewKeyDown" />
                </Grid>

                <Border Grid.Row="1"
                        Height="1"
                        VerticalAlignment="Top"
                        Background="{ThemeResource CardStrokeColorDefaultBrush}" />

                <ListView x:Name="ResultsList"
                          Grid.Row="1"
                          Margin="0,1,0,0"
                          MaxHeight="420"
                          SelectionMode="Single"
                          IsItemClickEnabled="True"
                          ItemClick="ResultsList_ItemClick">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="12,8,12,8" />
                            <Setter Property="MinHeight" Value="44" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="services:PaletteCommand">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0"
                                          Glyph="{x:Bind IconGlyph, Mode=OneTime}"
                                          FontSize="14"
                                          VerticalAlignment="Center"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <StackPanel Grid.Column="1"
                                            Margin="8,0,8,0"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Title, Mode=OneTime}"
                                               FontSize="14"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind Subtitle, Mode=OneTime}"
                                               FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               Visibility="{x:Bind local:Converters.NotEmpty(Subtitle), Mode=OneTime}" />
                                </StackPanel>
                                <TextBlock Grid.Column="2"
                                           Text="{x:Bind Group, Mode=OneTime}"
                                           FontSize="11"
                                           VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Empty state shown only when there are no matches AND
                     the user has typed something. Hidden while loading. -->
                <TextBlock x:Name="EmptyState"
                           Grid.Row="1"
                           Margin="0,40,0,40"
                           HorizontalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="No matches"
                           Visibility="Collapsed" />
            </Grid>
        </Border>
    </primitives:Popup>
</UserControl>
