<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Hermes.App.Controls.CodeBlockControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border Background="{ThemeResource HermesCodeBackgroundBrush}"
            CornerRadius="6"
            Padding="0"
            Margin="0,4,0,4">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  Padding="10,4,4,2"
                  ColumnSpacing="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="LanguageLabel"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                           Text="" />
                <Button x:Name="CopyButton"
                        Grid.Column="1"
                        Padding="6,2,8,2"
                        MinHeight="24"
                        FontSize="11"
                        Click="CopyButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon x:Name="CopyIcon"
                                  FontSize="12"
                                  Glyph="&#xE8C8;" />
                        <TextBlock x:Name="CopyLabel" Text="Copy" />
                    </StackPanel>
                </Button>
            </Grid>

            <RichTextBlock x:Name="CodeBody"
                           Grid.Row="1"
                           IsTextSelectionEnabled="True"
                           FontFamily="Consolas, 'Cascadia Mono', 'Segoe UI Mono', monospace"
                           FontSize="13"
                           LineHeight="18"
                           Foreground="{ThemeResource HermesCodePlainBrush}"
                           TextWrapping="Wrap"
                           Padding="10,2,10,8" />
        </Grid>
    </Border>
</UserControl>
